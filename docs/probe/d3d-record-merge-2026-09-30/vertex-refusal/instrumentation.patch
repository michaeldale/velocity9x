+/* Temporary Gen3 instrumentation overlays its unused S3 census entries.
+ * Shared layout and ABI stay unchanged; remove after refusal diagnosis. */
+typedef struct v9x_i9xx_vertex_failure {
+    DWORD magic; /* 0x56394636: V9F6 */
+    /* Last rejected runtime vertex, captured only on reason 6. Check bits:
+     * 1=x, 2=y, 4=z, 8=rhw, 16=u, 32=v. Valid triangles counts neighbours
+     * rejected along with the bad triangle; callback identifies the source.
+     * No pointers survive in this payload. */
+    DWORD i9xx_vertex_failures;
+    DWORD i9xx_vertex_fail_callback;
+    DWORD i9xx_vertex_fail_tick;
+    DWORD i9xx_vertex_fail_triangles;
+    DWORD i9xx_vertex_fail_valid_triangles;
+    DWORD i9xx_vertex_fail_index;
+    DWORD i9xx_vertex_fail_checks;
+    DWORD i9xx_vertex_fail_width;
+    DWORD i9xx_vertex_fail_height;
+    DWORD i9xx_vertex_fail_texture;
+    DWORD i9xx_vertex_fail_records;
+    DWORD i9xx_vertex_fail_bits[8];
+} V9X_I9XX_VERTEX_FAILURE;
+
 /*
  * Bounded HAL callback trace (Hellbender plan H1). Both sides append
  * fixed-size records to a ring inside the shared block, so the last
