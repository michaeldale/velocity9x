@@ -2022,6 +2023,59 @@ static DWORD v9x_d3d_i9xx_xyzw[V9X_I9XX_SUBMIT_VERTICES * 4ul];
 static DWORD v9x_d3d_i9xx_uv[V9X_I9XX_SUBMIT_VERTICES * 2ul];
 static DWORD v9x_d3d_i9xx_colors[V9X_I9XX_SUBMIT_VERTICES];
 
+/* Failure-only census using the builder's exact float predicates. Capturing
+ * bit patterns keeps signed zero and sub-pixel edge overshoot observable. */
+static void v9x_d3d_i9xx_vertex_failure(const V9X_R3D_DRAW *draw,
+    const V9X_D3DTLVERTEX *vertices, DWORD triangles, int textured,
+    DWORD texture_offset)
+{
+    V9X_I9XX_VERTEX_FAILURE *diag =
+        (V9X_I9XX_VERTEX_FAILURE *)v9x_hal->census.entries;
+    DWORD width = 0ul, height = 0ul, one = 0ul;
+    DWORD vertex, checks, triangle_bad = 0ul;
+    DWORD found = 0ul;
+    (void)v9x_i9xx_float_from_int(draw->target.width, &width);
+    (void)v9x_i9xx_float_from_int(draw->target.height, &height);
+    (void)v9x_i9xx_float_from_int(1ul, &one);
+    diag->magic = 0x56394636ul;
+    ++diag->i9xx_vertex_failures;
+    diag->i9xx_vertex_fail_callback = v9x_hal->trace.last_enter_id;
+    diag->i9xx_vertex_fail_tick = GetTickCount();
+    diag->i9xx_vertex_fail_triangles = triangles;
+    diag->i9xx_vertex_fail_valid_triangles = 0ul;
+    diag->i9xx_vertex_fail_checks = 0ul;
+    diag->i9xx_vertex_fail_width = draw->target.width;
+    diag->i9xx_vertex_fail_height = draw->target.height;
+    diag->i9xx_vertex_fail_texture = texture_offset;
+    diag->i9xx_vertex_fail_records = v9x_hal->d3d_diagnostics.dp_records;
+    for (vertex = 0ul; vertex < triangles * 3ul; ++vertex) {
+        const DWORD *bits = (const DWORD *)&vertices[vertex].sx;
+        checks = 0ul;
+        if (!v9x_i9xx_float_in_range(bits[0], width)) { checks |= 1ul; }
+        if (!v9x_i9xx_float_in_range(bits[1], height)) { checks |= 2ul; }
+        if (!v9x_i9xx_float_in_range(bits[2], one)) { checks |= 4ul; }
+        if (!v9x_i9xx_float_positive_finite(bits[3])) { checks |= 8ul; }
+        if (textured && !v9x_i9xx_float_finite(bits[6])) { checks |= 16ul; }
+        if (textured && !v9x_i9xx_float_finite(bits[7])) { checks |= 32ul; }
+        if (checks != 0ul) {
+            triangle_bad = 1ul;
+            if (!found) {
+                DWORD word;
+                found = 1ul;
+                diag->i9xx_vertex_fail_index = vertex;
+                diag->i9xx_vertex_fail_checks = checks;
+                for (word = 0ul; word < 8ul; ++word) {
+                    diag->i9xx_vertex_fail_bits[word] = bits[word];
+                }
+            }
+        }
+        if (vertex % 3ul == 2ul) {
+            if (!triangle_bad) { ++diag->i9xx_vertex_fail_valid_triangles; }
+            triangle_bad = 0ul;
+        }
+    }
+}
