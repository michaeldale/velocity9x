{"host_time_ns": 1789098158063655745, "event": "ramdac_read_intent", "schema": 1, "descriptor_id": "tvp3026-on-mga2064w-v1", "window_source": "MGA-2064W Specification Table 3-3 places the RAMDAC in mgabase1 + 3C00h..3DFFh and states the exact mapping within that range depends on the RAMDAC and the external connection, so it is not derivable from that document alone. Base 3C00h with the TVP3026 RS3-RS0 select lines as the low four address bits is corroborated two ways on this board: the card's own BIOS leaves MGA_INDEX (PCI configuration 44h) holding 0x3C0A, which is 3C00h plus RS=1010b, the TVP3026 Indexed Data register (TVP3026 datasheet Table 2-1); and the verb refuses to decode unless the indirect ID register at that mapping reads its documented value.", "mapping_is_proved_not_assumed": true, "selectors_written": ["index register", "PLL address register"], "pll_values_written": false, "clock_source_written": false, "palette_written": false, "index_register_doubles_as_palette_write_address": true, "both_selectors_saved_and_restored": true, "arbiter_lock": "blocking", "bridge_latch_is_not_restorable": true, "bdf": "0000:04:06.0", "boot_id": "195e37e1-bf59-4176-a743-e60810f581ca", "bar": 0, "bar_base": 4258250752, "bar_size": 16384, "ramdac_offset": 15360, "index_port_offset": 0, "data_port_offset": 10, "expect_id_register": 63, "expect_id_value": 38, "bridge_bdf": "0000:00:14.4", "allow_boot_vga": true}
