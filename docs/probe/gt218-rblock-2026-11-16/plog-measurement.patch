+/* MEASUREMENT ONLY: on the 800th and 2000th idle wait with a clean,
+ * owned shadow, the raw bytes around it to C:\V9XDIAG\V9XN50Mn.BIN:
+ * a header of DWORDs, the Z's last 64 KiB, the colour's first 64 KiB,
+ * the colour's last 64 KiB, and the owner's first and last 8 rows. */
+static DWORD v9x_nv50_plog_waits = 0ul;
+
+static void v9x_nv50_plog_write(HANDLE file, DWORD offset, DWORD bytes)
+{
+    DWORD written;
+
+    (void)WriteFile(file,
+                    (const void *)(v9x_hal->fb.linear_base + offset), bytes,
+                    &written, 0);
+}
+
+void v9x_d3d_nv50_plog_dump(void)
+{
+    V9X_D3D_NV50_SHADOW *shadow = 0;
+    DWORD header[16];
+    DWORD index;
+    DWORD written;
+    DWORD colour_end;
+    DWORD owner_rows;
+    HANDLE file;
+    char path[] = V9X_DIAG_PATH("V9XN50M0.BIN");
+
+    for (index = 0ul; index < V9X_D3D_NV50_SHADOWS_MAX; ++index) {
+        if (v9x_d3d_nv50_shadows[index].used != 0ul &&
+            v9x_d3d_nv50_shadows[index].owner != V9X_D3D_NV50_NONE &&
+            v9x_d3d_nv50_shadows[index].dirty == 0ul) {
+            shadow = &v9x_d3d_nv50_shadows[index];
+            break;
+        }
+    }
+    if (shadow == 0) {
+        return;
+    }
+    ++v9x_nv50_plog_waits;
+    if (v9x_nv50_plog_waits != 800ul && v9x_nv50_plog_waits != 2000ul) {
+        return;
+    }
+    path[sizeof(path) - 6] = v9x_nv50_plog_waits == 800ul ? '1' : '2';
+    colour_end = shadow->colour_offset +
+                 ((shadow->width * 4ul + 63ul) & ~63ul) *
+                     ((shadow->height + 7ul) & ~7ul);
+    owner_rows = shadow->owner_pitch * 8ul;
+    for (index = 0ul; index < 16ul; ++index) {
+        header[index] = 0ul;
+    }
+    header[0] = 0x4d303556ul;
+    header[1] = shadow->z_offset;
+    header[2] = shadow->colour_offset;
+    header[3] = shadow->width;
+    header[4] = shadow->height;
+    header[5] = shadow->owner;
+    header[6] = shadow->owner_pitch;
+    header[7] = shadow->owner_width;
+    header[8] = shadow->owner_height;
+    header[9] = shadow->owner_bytes;
+    header[10] = colour_end;
+    header[11] = v9x_nv50_plog_waits;
+    file = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, 0,
+                       CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
+    if (file == INVALID_HANDLE_VALUE) {
+        return;
+    }
+    (void)WriteFile(file, header, sizeof(header), &written, 0);
+    v9x_nv50_plog_write(file, shadow->colour_offset - 0x10000ul, 0x10000ul);
+    v9x_nv50_plog_write(file, shadow->colour_offset, 0x10000ul);
+    v9x_nv50_plog_write(file, (colour_end - 0x10000ul) & ~0xfffful,
+                        0x20000ul);
+    v9x_nv50_plog_write(file, shadow->owner, owner_rows);
+    v9x_nv50_plog_write(file,
+                        shadow->owner + shadow->owner_pitch *
+                                            (shadow->owner_height - 8ul),
+                        owner_rows);
+    v9x_nv50_plog_write(file, shadow->z_offset - 0x10000ul, 0x20000ul);
+    CloseHandle(file);
+}
