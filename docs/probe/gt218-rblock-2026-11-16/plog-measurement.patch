+/* MEASUREMENT ONLY (not for commit): every placement, shadow load and new
+ * draw target to C:\V9XDIAG\V9XN50P.TXT, to find what the 800x600x32
+ * Quake 3 colour shadow's first tile row shares memory with. */
+#define V9X_NV50_PLOG_MAX 6000ul
+static DWORD v9x_nv50_plog_lines = 0ul;
+static DWORD v9x_nv50_plog_targets[32];
+static DWORD v9x_nv50_plog_target_count = 0ul;
+
+static void v9x_nv50_plog(char tag, DWORD a, DWORD b, DWORD c, DWORD d,
+                          DWORD e)
+{
+    static const char digits[] = "0123456789ABCDEF";
+    char line[64];
+    DWORD values[5];
+    DWORD length = 0ul;
+    DWORD index;
+    DWORD nibble;
+    DWORD written;
+    HANDLE file;
+
+    if (v9x_nv50_plog_lines >= V9X_NV50_PLOG_MAX) {
+        return;
+    }
+    ++v9x_nv50_plog_lines;
+    values[0] = a;
+    values[1] = b;
+    values[2] = c;
+    values[3] = d;
+    values[4] = e;
+    line[length++] = tag;
+    for (index = 0ul; index < 5ul; ++index) {
+        line[length++] = ' ';
+        for (nibble = 0ul; nibble < 8ul; ++nibble) {
+            line[length++] =
+                digits[(values[index] >> ((7ul - nibble) * 4ul)) & 0xful];
+        }
+    }
+    line[length++] = '\r';
+    line[length++] = '\n';
+    CreateDirectoryA(V9X_DIAG_DIR, 0);
+    file = CreateFileA(V9X_DIAG_PATH("V9XN50P.TXT"), GENERIC_WRITE,
+                       FILE_SHARE_READ, 0, OPEN_ALWAYS,
+                       FILE_ATTRIBUTE_NORMAL, 0);
+    if (file == INVALID_HANDLE_VALUE) {
+        return;
+    }
+    (void)SetFilePointer(file, 0, 0, FILE_END);
+    (void)WriteFile(file, line, length, &written, 0);
+    CloseHandle(file);
+}
 
