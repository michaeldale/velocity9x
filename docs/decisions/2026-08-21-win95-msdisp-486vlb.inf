; MSDISP.INF
; - Installs core display support files, etc.
; - Includes drivers for detected & PnP devices

[version]
LayoutFile=layout.inf
signature="$CHICAGO$"
Class=Display
Provider=%MS%
SetupClass=BASE

[DestinationDirs]
DefaultDestDir  =11		;LDID_SYS
CpqIni.Copy     =10		;LDID_WIN
VMM32.Copy      =22         	;LDID_VMM32
ATI.RenFiles    =10		;LDID_WIN
Compaq.RenFiles =11		;LDID_SYS
Orchid.RenFiles =11		;LDID_SYS
Chips.RenFiles  =11		;LDID_SYS
NCR.RenFiles    =11		;LDID_SYS


; Base Install Sections 
; ---------------------------------------------------------
[BaseWinOptions]
DisplayBase

[DisplayBase]
CopyFiles=System.Copy, VMM32.Copy
UpdateInis=VMM32.Ini
addreg=VMM32.Reg
RenFiles=NCR.RenFiles

[System.Copy]
vga.drv
framebuf.drv
vgafull.3gr

[VMM32.Copy]
vdd.vxd
vflatd.vxd

[VMM32.Ini]
wininit.ini, CombineVxDs,,"%22%\vdd.vxd=%11%\vmm32.vxd"
wininit.ini, CombineVxDs,,"%22%\vflatd.vxd=%11%\vmm32.vxd"

[VMM32.Reg]
HKLM,System\CurrentControlSet\Control\VMM32Files,vdd.vxd,1,
HKLM,System\CurrentControlSet\Control\VMM32Files,vflatd.vxd,1,

[NCR.RenFiles]
skyeagle.cp0,skyeagle.cpl

[SysCfgClasses]
Display,%*PNP0900.DeviceDesc%,ROOT,,%Display.SetupClassName%
			;Default to VGA if detection fails or no
			;display is detected or if setup /i is run

[Modules]
MSDispDetect=MSDISP.DLL

[MSDispDetect]
0=display,msdisp.inf

; The section below has to be empty. The Class classinstaller
; relays on it. Dont add anything to this section.
[EmptySection]


; Incompatible driver list: Forces Win3.1 upgrades to VGA 
; if one of these drivers is installed.
; ---------------------------------------------------------
[display.update.force]
vgamono.drv,*,*	; Win3.x VGA mono driver
*,vddagx.386,*		; IIT AGX (e.g. Hercules Graphite)
agx.drv,*,*
agx16.drv,*,*
agx64024.drv,*,*
agx80016.drv,*,*
agx80024.drv,*,*
agx1280.drv,*,*
wspdsf.drv,*,*		; IBM ThinkPad 486/50
vgap.drv,*,*		; Pen Windows 3.1 VGA driver
sspro16.drv,*,* 	; SpeedStar Pro 16 colors
p9100_16.drv,*,*	; Weitek 9100 16bpp
*,v98032.386,*		; Appian Renegade
98032_08.drv,*,*
98032_16.drv,*,*
commdis.drv,*,*	; CPS Commute display driver replacement
rgdi.drv,*,*		; Appian RGDI
*,rgdi.386,*
oakvga.drv,*,*		; Oak Spitfire
gogh480.drv,*,*	; Toshiba 
t19v480.drv,*,*
avga6256.drv,*,*	; AVGA2
avga8256.drv,*,*
tliw32p8.drv,*,*	; Tseng W32p - require dva.386
tliw32p3.drv,*,*	; (Needed in case of misdetection)
tliw32p6.drv,*,*
tliw32p1.drv,*,*
hires32.drv,*,*		; Media Vision ProGraphics 1280
pro1280.drv,*,*
*,vddark.386,*		; ARK Logic

; Win3.1 drivers that should *not* be updated by Win95:
; ---------------------------------------------------------
[display.update.fail]
i128.drv,*,*		; Number Nine Imagine 128
*,vddi128.386,*


; Install class "Display"
; ---------------------------------------------------------
[ClassInstall]
AddReg=ClassAddReg
DelReg=ClassDelReg

[ClassAddReg]
HKR,,,,%ClassName%
HKR,,Installer,,"SetupX.Dll, Display_ClassInstaller"
HKR,,Icon,,"-1"

[ClassDelReg]
HKLM,System\CurrentControlSet\Services\Class\Display,EnumPropPages


; Device IDs to exclude from Setup pick list
; ---------------------------------------------------------
[ControlFlags]
ExcludeFromSelect=*PNP0917			; Special ID
ExcludeFromSelect=*ATI4402			; ATI EISA mach32
ExcludeFromSelect=PCI\VEN_1005&DEV_2301		; Avance Logic PCI
ExcludeFromSelect=PCI\VEN_100E&DEV_9001		; Weitek P9000
ExcludeFromSelect=PCI\VEN_100E&DEV_9100		; Weitek P9100
ExcludeFromSelect=PCI\VEN_EDD8&DEV_A091		; ARK Logic
ExcludeFromSelect=NullId1,NullId2,NullId3,NullId4	; Unsupported PCI adapters


; Manufacturers
; ---------------------------------------------------------
[Manufacturer]
%Std%    =Mfg.Std
%Actix%  =Mfg.Actix
%ARK%    =Mfg.ARK
%ATI%    =Mfg.ATI
%Avance% =Mfg.Avance
