// Velocity9x Display Properties page dialog template.
// The logo bitmap resource (101) is appended by the build script.
//
// HEIGHT IS THE BINDING CONSTRAINT. A property sheet sizes itself to its
// tallest page, and this page is the tallest, so its height sets the size of
// the whole native Display Properties dialog. The driver's default first boot
// is 640x480, where the work area is about 450 pixels tall; a page much over
// 211 dialog units pushes the OK/Cancel/Apply row off the bottom of the
// screen and makes the dialog unusable. Rows are on an 11-unit pitch and the
// logo gets a deliberately modest slot for that reason. Re-check at 640x480
// after changing anything here.
//
// The logo slot must also stay larger than the generated bitmap in both axes:
// SS_CENTERIMAGE centres the image and clips whatever does not fit rather
// than scaling it. The bitmap is generated at 185x37 (see
// scripts/build-settings-page.ps1) against this 238x24 slot.
//
// The Direct3D row is the one exception to that: it is a combo box, not a
// label, and it is the only control here that changes anything. It replaced
// the value LTEXT in place rather than being added as a new row, because the
// height budget above has none to give - a dropped-down combo costs nothing
// vertically, an extra row costs 11 units and would push the dialog past 211.
// Its cy of 60 is the dropped-down height; closed it occupies about 12 units
// from y=122, clearing the 136 row below it.
//
// The list is built at run time and holds only what this build implements,
// which is the same discipline the driver applies to capabilities: an
// unimplemented mode is not offered. When SYSTEM.INI already names one, the
// page adds an entry for it so that opening the page cannot silently rewrite
// a setting somebody put there deliberately.
//
// Every other row is a read-only label/value pair. The page previously used
// disabled checkboxes for "DIB Engine rendering", "Hardware acceleration"
// and "Live mode switching", but those are statements of fact rather than
// settings: a permanently checked, permanently greyed box tells the reader
// nothing it could ever not say. They are value rows now, naming what the
// driver actually does, and they can report a narrower answer on a chip or a
// build where less is available.
#include <windows.h>
#include "settings_propsheet.h"

V9X_ID_PAGE_DIALOG DIALOG 0, 0, 252, 211
STYLE DS_3DLOOK | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Velocity9x"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "#101", -1, "STATIC", SS_BITMAP | SS_CENTERIMAGE,
                    7, 2, 238, 24

    GROUPBOX        "Display adapter", -1, 7, 30, 238, 58
    LTEXT           "Adapter:", -1, 14, 41, 56, 8
    LTEXT           "", V9X_IDC_ADAPTER, 72, 41, 166, 8
    LTEXT           "PCI ID:", -1, 14, 52, 56, 8
    LTEXT           "", V9X_IDC_PCI_ID, 72, 52, 58, 8
    LTEXT           "Video memory:", -1, 134, 52, 50, 8
    LTEXT           "", V9X_IDC_VIDEO_MEMORY, 186, 52, 52, 8
    LTEXT           "Active mode:", -1, 14, 63, 56, 8
    LTEXT           "", V9X_IDC_ACTIVE_MODE, 72, 63, 166, 8
    LTEXT           "Clock:", -1, 14, 74, 56, 8
    LTEXT           "", V9X_IDC_CORE_CLOCK, 72, 74, 166, 8

    GROUPBOX        "Acceleration", -1, 7, 92, 238, 58
    LTEXT           "Rendering:", -1, 14, 103, 56, 8
    LTEXT           "", V9X_IDC_RENDERING, 72, 103, 166, 8
    LTEXT           "DirectDraw:", -1, 14, 114, 56, 8
    LTEXT           "", V9X_IDC_DIRECTDRAW, 72, 114, 166, 8
    LTEXT           "Direct3D:", -1, 14, 125, 56, 8
    COMBOBOX        V9X_IDC_DIRECT3D_MODE, 72, 122, 166, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Mode switching:", -1, 14, 136, 56, 8
    LTEXT           "", V9X_IDC_MODE_SWITCH, 72, 136, 166, 8

    GROUPBOX        "Runtime diagnostics", -1, 7, 154, 238, 36
    LTEXT           "Driver / framebuffer:", -1, 14, 165, 66, 8
    LTEXT           "", V9X_IDC_FRAMEBUFFER, 82, 165, 156, 8
    LTEXT           "Last GDI test:", -1, 14, 176, 66, 8
    LTEXT           "", V9X_IDC_GDI_TEST, 82, 176, 156, 8

    LTEXT           "", V9X_IDC_VERSION, 7, 195, 80, 8
    LTEXT           "", V9X_IDC_BUILD, 89, 195, 96, 8
    LTEXT           "", V9X_IDC_NOTICE, 0, 0, 0, 0

    PUSHBUTTON      "Copy report", V9X_IDC_COPY_REPORT, 190, 193, 55, 14
END
